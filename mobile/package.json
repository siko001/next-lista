{
  "name": "lista-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "apk": "npm run build && cap sync android && node scripts/android-build.mjs assembleDebug",
    "bundle": "npm run build && cap sync android && node scripts/android-build.mjs bundleRelease",
    "signing:setup": "node scripts/setup-signing.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:packaged": "npm run build && playwright test --config playwright.packaged.config.js",
    "links": "node scripts/association-files.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource-variable/quicksand": "^5.2.0",
    "@fontsource-variable/saira": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.3.1"
  }
}
